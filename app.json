{
  "expo": {
    "name": "Workout Manager",
    "slug": "workout-manager",
    "scheme": "workoutmanager",
    "version": "0.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.ccerbusca.workoutmanager"
    },
    "android": {
      "package": "io.github.ccerbusca.workoutmanager",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "permissions": [
        "VIBRATE",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications",
      "expo-font"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41d6ca96-674c-4c5c-a4d4-dd90e6fbe200"
      }
    }
  }
}
